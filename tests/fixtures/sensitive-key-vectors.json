    { "key": "sample.oauth.refresh_token", "sensitive": true },
    { "key": "sample.erp.tokenId", "sensitive": true },
    { "key": "sample.erp.tokenSecret", "sensitive": true },
    { "key": "sample.erp.consumerKey", "sensitive": true },
    { "key": "sample.erp.consumerSecret", "sensitive": true },
    { "key": "sample.tls.privateKey", "sensitive": true },
    { "key": "sample.tls.keyPassword", "sensitive": true },
    { "key": "sample.tls.passphrase", "sensitive": true },
    { "key": "sample.credentials", "sensitive": true },
