{
    "name": "@sfdxy/mule-lint",
    "version": "1.18.0",
    "description": "Static analysis tool for MuleSoft applications - supports humans, AI agents, and CI/CD pipelines",
    "author": "Avinava",
    "license": "MIT",
    "keywords": [
        "mulesoft",
        "mule",
        "lint",
        "static-analysis",
        "xml",
        "sarif",
        "cli"
    ],
    "bin": {
        "mule-lint": "./dist/bin/mule-lint.js",
        "mule-lint-mcp": "./dist/bin/mule-lint-mcp.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "docs"
    ],
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
        "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
        "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
        "lint": "eslint src/ --ext .ts",
        "lint:fix": "eslint src/ --ext .ts --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build && npm test",
        "release": "git tag v$(node -p 'require(\"./package.json\").version') && git push origin v$(node -p 'require(\"./package.json\").version')"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.25.2",
        "@prettier/plugin-xml": "^3.4.2",
        "@xmldom/xmldom": "^0.8.10",
        "chalk": "^4.1.2",
        "commander": "^11.1.0",
        "fast-glob": "^3.3.2",
        "js-yaml": "^4.1.1",
        "prettier": "^3.8.1",
        "xpath": "^0.0.34",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.11",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.27",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Avinava/mule-lint.git"
    },
    "bugs": {
        "url": "https://github.com/Avinava/mule-lint/issues"
    },
    "homepage": "https://github.com/Avinava/mule-lint#readme"
}
